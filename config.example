# Example environment variables for live integrations
# Copy to .env and fill in

# Flight cash
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
DUFFEL_API_TOKEN=

# Award search
AWARDTOOL_API_KEY=
SEATS_AERO_API_KEY=

# Hotels
BOOKING_API_KEY=

# Optional
TPG_SCRAPE_ENABLED=false

# --- Live providers used by Bouncer (bouncer/live_providers.py) ---
# Leave blank to use mock data. Set BOUNCER_USE_MOCK=1 to force mocks even when keys exist
# (saves the small free quotas during development). CLI: python main.py --mock
BOUNCER_USE_MOCK=

# FlightPowers via RapidAPI: one key for Google Flights Live API (cash flights) and
# Booking Live API (hotels). Subscribe to the free BASIC plan on each listing
# (10 searches/month each, no card). FLIGHTPOWERS_API_KEY is accepted as an alias.
RAPIDAPI_KEY=

# Award Travel Finder (https://awardtravelfinder.com/developers): X-API-Key for
# British Airways / Cathay Pacific award availability. Free tier is limited (economy, small monthly quota).
AWARDTRAVELFINDER_API_KEY=
# Registration key from Award Travel Finder's agent sign-up flow (/api/v1/agent/register); kept for reference, not used by the app.
AWARDTRAVELFINDER_REGISTRATION_KEY=
